{
    "name": "@dpuse/dpuse-presenter-default",
    "version": "0.1.1073",
    "private": false,
    "description": "A library that implements the default presenter in accordance with the Data Positioning presenter interface.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-presenter-default/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-presenter-default.git"
    },
    "module": "./dist/dpuse-presenter-default.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/dpuse-presenter-default.es.js",
            "types": "./dist/types/src/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20260930.2": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "prebuild": "node scripts/prebuild.ts",
        "build": "node -e \"import('@dpuse/dpuse-development').then(m => m.buildProject())\"",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject('Apache-2.0;BSD-3-Clause;MIT'))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && gh release create \"v$(npm pkg get version | tr -d '\"')\" --target \"$(git rev-parse HEAD)\" --generate-notes --latest",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\""
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^0.3.865",
        "dompurify": "^3.4.16"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^0.3.808",
        "@dpuse/dpuse-tool-highcharts-visualiser": "^0.0.92",
        "@dpuse/dpuse-tool-micromark-markdown-parser": "^0.1.1051",
        "@dpuse/eslint-config-dpuse": "^1.0.124",
        "@types/node": "^26.6.3",
        "eslint": "^10.11.0",
        "front-matter": "^4.0.2",
        "prettier": "^3.9.9",
        "sonda": "^0.14.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.2",
        "vite-plugin-dts": "^5.1.1",
        "vitest": "^5.0.3",
        "wrangler": "^4.145.0"
    }
}
